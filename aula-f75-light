#!/usr/bin/env python3
"""CLI helper: set Aula F75 Max lighting over the 2.4G receiver."""
import argparse
import ctypes
import sys
import time

LIB = ctypes.CDLL("libhidapi-hidraw.so.0")

class hid_device_info(ctypes.Structure):
    pass

hid_device_info._fields_ = [
    ("path", ctypes.c_char_p),
    ("vendor_id", ctypes.c_ushort),
    ("product_id", ctypes.c_ushort),
    ("serial_number", ctypes.c_wchar_p),
    ("release_number", ctypes.c_ushort),
    ("manufacturer_string", ctypes.c_wchar_p),
    ("product_string", ctypes.c_wchar_p),
    ("usage_page", ctypes.c_ushort),
    ("usage", ctypes.c_ushort),
    ("interface_number", ctypes.c_int),
    ("next", ctypes.POINTER(hid_device_info)),
]

LIB.hid_init.restype = ctypes.c_int
LIB.hid_enumerate.restype = ctypes.POINTER(hid_device_info)
LIB.hid_enumerate.argtypes = [ctypes.c_ushort, ctypes.c_ushort]
LIB.hid_free_enumeration.argtypes = [ctypes.POINTER(hid_device_info)]
LIB.hid_open_path.restype = ctypes.c_void_p
LIB.hid_open_path.argtypes = [ctypes.c_char_p]
LIB.hid_close.argtypes = [ctypes.c_void_p]
LIB.hid_set_nonblocking.argtypes = [ctypes.c_void_p, ctypes.c_int]
LIB.hid_write.restype = ctypes.c_int
LIB.hid_write.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ubyte), ctypes.c_size_t]

DONGLE_VID = 0x05AC
DONGLE_PID = 0x024F
RAW_USAGE_PAGE = 0xFF60

MODES = {
    "off": 0, "static": 1, "singleon": 2, "singleoff": 3, "glittering": 4,
    "falling": 5, "colourful": 6, "breath": 7, "spectrum": 8, "outward": 9,
    "scrolling": 10, "rolling": 11, "rotating": 12, "explode": 13, "launch": 14,
    "ripples": 15, "flowing": 16, "pulsating": 17, "tilt": 18, "shuttle": 19,
}

def checksum(buf):
    buf[-1] = 0
    s = 0
    for b in buf:
        s = (s + b) & 0xFF
    buf[-1] = s

def commit_report():
    r = bytearray(32)
    r[0] = 0x0F
    checksum(r)
    return bytes(r)

def led_report(mode, brightness, speed, direction, colorful, color):
    r = bytearray(32)
    r[0] = 0x05
    r[1] = 0x10
    r[2] = 0x00
    r[3] = mode & 0xFF
    if mode != 0:
        r[4] = (color >> 16) & 0xFF
        r[5] = (color >> 8) & 0xFF
        r[6] = color & 0xFF
        r[11] = 1 if colorful else 0
        r[12] = brightness & 0xFF
        r[13] = speed & 0xFF
        r[14] = direction & 0xFF
    r[17] = 0xAA
    r[18] = 0x55
    checksum(r)
    return bytes(r)

def find_raw_path():
    LIB.hid_init()
    devs = LIB.hid_enumerate(DONGLE_VID, DONGLE_PID)
    if not devs:
        return None
    cur = devs
    raw_candidates = []
    all_candidates = []
    while cur:
        info = cur.contents
        if info.path:
            all_candidates.append(info.path)
            if info.usage_page == RAW_USAGE_PAGE:
                raw_candidates.append(info.path)
        cur = info.next
    LIB.hid_free_enumeration(devs)
    if raw_candidates:
        return raw_candidates[0]
    if all_candidates:
        return all_candidates[0]
    return None

def write_report(dev, data):
    arr = (ctypes.c_ubyte * len(data))(*data)
    n = LIB.hid_write(dev, arr, len(data))
    if n >= 0:
        return n
    # fallback: prefix report id 0
    prefixed = bytes([0]) + data
    arr2 = (ctypes.c_ubyte * len(prefixed))(*prefixed)
    return LIB.hid_write(dev, arr2, len(prefixed))

def main():
    p = argparse.ArgumentParser(description="Set Aula F75 Max lighting via 2.4G receiver")
    p.add_argument("mode", nargs="?", help="effect name or 0-19")
    p.add_argument("--list", action="store_true", help="list effect names/ids and exit")
    p.add_argument("-b", "--brightness", type=int, default=4, help="1-5")
    p.add_argument("-s", "--speed", type=int, default=3, help="1-5")
    p.add_argument("-d", "--direction", type=int, default=0, help="0 right,1 down,2 left,3 up")
    p.add_argument("-c", "--color", default="ffffff", help="RRGGBB when not colorful")
    p.add_argument("--colorful", action="store_true", help="rainbow palette")
    args = p.parse_args()

    if args.list:
        for name, mid in MODES.items():
            print(f"{mid:2d} {name}")
        return

    if not args.mode:
        p.error("mode is required (use --list to see options)")

    if args.mode.isdigit():
        mode = int(args.mode)
    else:
        mode = MODES.get(args.mode.lower())
        if mode is None:
            print("Unknown mode:", args.mode, file=sys.stderr)
            print("Modes:", ", ".join(f"{k}={v}" for k, v in MODES.items()), file=sys.stderr)
            sys.exit(2)
    mode = min(max(mode, 0), 19)
    brightness = min(max(args.brightness, 1), 5)
    speed = min(max(args.speed, 1), 5)
    direction = min(max(args.direction, 0), 3)
    color = int(args.color, 16)

    path = find_raw_path()
    if not path:
        print("Dongle not found. Is it plugged in and udev rule installed?", file=sys.stderr)
        sys.exit(1)

    dev = LIB.hid_open_path(path)
    if not dev:
        print("Failed to open dongle raw HID path:", path, file=sys.stderr)
        sys.exit(1)
    LIB.hid_set_nonblocking(dev, 0)

    try:
        n = write_report(dev, commit_report())
        if n < 0:
            print("commit write failed:", n, file=sys.stderr)
            sys.exit(1)
        time.sleep(0.05)
        n = write_report(dev, led_report(mode, brightness, speed, direction, args.colorful, color))
        if n < 0:
            print("LED write failed:", n, file=sys.stderr)
            sys.exit(1)
        print(f"Applied: mode={mode} brightness={brightness} speed={speed} direction={direction} colorful={args.colorful} color=0x{color:06X}")
    finally:
        LIB.hid_close(dev)

if __name__ == "__main__":
    main()
